# Database Configuration
# For local Docker usage this project maps PostgreSQL to host port 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=openfamily
POSTGRES_USER=openfamily
POSTGRES_PASSWORD=openfamily2024

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# Client Configuration
# Leave these EMPTY for the standard Docker / all-in-one setup: the web app talks to
# its own origin and nginx proxies /api and /ws to the backend, so it works from any
# device (localhost, LAN IP, hostname, HTTPS reverse proxy) with no extra config.
# Set them only if you serve the API from a SEPARATE origin/domain.
VITE_API_URL=
VITE_WS_URL=

# Web Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# JWT Secret (Generate a random string: openssl rand -hex 32)
JWT_SECRET=replace-me-with-a-long-random-secret

# Auth rate limiting (anti brute-force)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Time zone of the family (IANA name: Europe/Paris, America/Montreal, Europe/Lisbon...).
# Reminders and imported calendars (Google, Outlook, .ics) use it.
TZ=Europe/Paris

# Registration. false closes sign-ups: nobody can create an account on their
# own, but a person invited from the Family page (link or e-mail) still can.
REGISTRATION_ENABLED=true

# ---------------------------------------------------------------------------
# E-mail transactionnel (SMTP) : OPTIONNEL mais recommandé
# Sert à envoyer les invitations de famille par e-mail et les liens de
# réinitialisation de mot de passe. Si SMTP_HOST ou MAIL_FROM est vide, le
# mailer reste inerte : aucun envoi, aucune erreur au démarrage. Les invitations
# restent alors partageables via leur lien, mais la réinitialisation de mot de
# passe par e-mail n'est pas disponible.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse expéditrice, ex : "OpenFamily <openfamily@mondomaine.fr>".
MAIL_FROM=
# Adresse de support affichée dans les e-mails. Vide = ligne omise.
SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# URL publique de l'instance : OPTIONNEL
# Utilisée pour construire les liens envoyés HORS de l'application (invitations,
# réinitialisation de mot de passe). Par défaut le serveur utilise l'origine de
# la requête, ce qui convient dans la quasi-totalité des cas. À définir seulement
# si le serveur est derrière un reverse proxy dont il ne voit pas le nom public.
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Android App Links : OPTIONNEL
# Empreinte(s) SHA-256 du certificat de signature de VOTRE build de l'app,
# séparées par des virgules. Quand elle est définie, le serveur publie
# /.well-known/assetlinks.json et les liens d'invitation ouvrent directement
# l'application. Vide = endpoint 404, les liens s'ouvrent dans le navigateur.
# ---------------------------------------------------------------------------
ANDROID_CERT_SHA256=
ANDROID_PACKAGE_NAME=

# ---------------------------------------------------------------------------
# --- Custom ---------------------------------------------------------------
# Everything below belongs to this fork, not to upstream. Names are prefixed
# CUSTOM_ so an upstream sync never has to resolve a collision, and every
# variable is optional: leave them unset and the app behaves like upstream.
# ---------------------------------------------------------------------------

# Feature switches for the fork's own features. Absent or any value other than
# "false"/"0" means ENABLED. Switching one off unmounts its API routes AND hides
# its pages, nav entries and dashboard widgets (the server reports it as a
# disabled module). Useful to compare against upstream, or to bisect a merge.
CUSTOM_FEATURE_WEATHER_ENABLED=true
CUSTOM_FEATURE_MEDIA_ENABLED=true
CUSTOM_FEATURE_BUDGET_RECEIPTS_ENABLED=true
CUSTOM_FEATURE_BUDGET_ANALYTICS_ENABLED=true
CUSTOM_FEATURE_AI_WIDGETS_ENABLED=true
# Lunchboxes (per child, per day) and their weekly nutritional read. Own page,
# own table (`custom_lunchboxes`); the upstream meal planner is untouched. Needs
# no extra variable: its two AI calls reuse the AI settings of /api/ai.
CUSTOM_FEATURE_LUNCHBOX_ENABLED=true

# Database connection. TLS towards the database: disable (default, local
# container) | require | verify-full. A managed database requires TLS, so
# CUSTOM_POSTGRES_SSL=verify-full. The timeout is how long to wait for a
# connection: widen it for a database that sleeps when idle, since a suspended
# compute has to wake up before it accepts the connection.
CUSTOM_POSTGRES_SSL=disable
CUSTOM_POSTGRES_CONNECT_TIMEOUT_MS=2000

# Object storage for images : OPTIONNEL. Avatars, recipe photos and post photos
# are sent inline (data: URLs) by the browser; with a bucket configured the
# server uploads those bytes there and stores an `s3:<key>` reference in
# PostgreSQL instead, which keeps the database small. The bucket stays PRIVATE:
# the API serves the bytes itself through /api/media/<key>, signed and expiring,
# so the browser never talks to the storage endpoint. Any S3-compatible service
# works (MinIO, Scaleway, AWS, OVH). Leave empty and images stay inline in the
# database, as they always did.
CUSTOM_MINIO_ENDPOINT=
CUSTOM_MINIO_ACCESS_KEY=
CUSTOM_MINIO_SECRET_KEY=
CUSTOM_MINIO_BUCKET=
# Region: irrelevant for MinIO, required by the SDK (fr-par for Scaleway).
CUSTOM_MINIO_REGION=us-east-1

# Weather, clothing suggestions and screen-free activities : OPTIONNEL.
# Provided by Open-Meteo, which needs no API key, so the app works without
# configuring anything here. These variables point at a mirror instance, change
# the language of geocoded city names, or adjust the caching and timeouts.
CUSTOM_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
CUSTOM_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
CUSTOM_WEATHER_DEFAULT_LANG=fr
# Server-side cache duration, in milliseconds (10 minutes by default).
CUSTOM_WEATHER_CACHE_TTL_MS=600000
# Maximum duration of one request to Open-Meteo, in milliseconds.
CUSTOM_WEATHER_REQUEST_TIMEOUT_MS=8000
